{
  "info": {
    "name": "Tra Thai Nguyen API",
    "description": "Khung kiểm thử API. Các endpoint commerce cần được xác nhận lại sau khi nhánh backend được merge.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [{
        "name": "Health check",
        "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{base_url}}/health" },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
          "pm.test('Backend is UP', () => pm.expect(pm.response.json().data.status).to.eql('UP'));"
        ] } }]
      }]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Khach Hang Test\",\n  \"email\": \"khach.test@example.com\",\n  \"password\": \"Test123456\"\n}" },
            "url": "{{api_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"khach.test@example.com\",\n  \"password\": \"Test123456\"\n}" },
            "url": "{{api_url}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Login successful', () => pm.response.to.have.status(200));",
            "const data = pm.response.json().data || {};",
            "if (data.token) pm.environment.set('access_token', data.token);",
            "if (data.refreshToken) pm.environment.set('refresh_token', data.refreshToken);"
          ] } }]
        },
        { "name": "Profile", "request": { "method": "GET", "url": "{{api_url}}/auth/profile" } },
        {
          "name": "Refresh token",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": "{{api_url}}/auth/refresh"
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" }, "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}" },
            "url": "{{api_url}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        { "name": "List products", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{api_url}}/products" } },
        { "name": "Product detail", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{api_url}}/products/{{product_id}}" } }
      ]
    },
    {
      "name": "Cart and Orders",
      "item": [
        { "name": "Get cart", "request": { "method": "GET", "url": "{{api_url}}/cart" } },
        {
          "name": "Update cart",
          "request": {
            "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"items\": []\n}" }, "url": "{{api_url}}/cart"
          }
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerName\": \"Khach Hang Test\",\n  \"customerPhone\": \"0900000000\",\n  \"shippingAddress\": \"Thai Nguyen\",\n  \"shippingProvince\": \"Thai Nguyen\"\n}" },
            "url": "{{api_url}}/orders"
          }
        },
        { "name": "My orders", "request": { "method": "GET", "url": "{{api_url}}/orders/my" } }
      ]
    }
  ]
}
