PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/boilerplate_db?schema=public"
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
CORS_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:5000
FRONTEND_AUTH_URL=http://localhost:3000/auth.html

# Google Console callback: http://localhost:5000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta Developers callback: http://localhost:5000/api/v1/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
